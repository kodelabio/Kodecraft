ameters":{"jsCode":"const data = $input.first().json;\nconst body = data.body;\n\n// Remap tasks with actual worker names\nconst remappedTasks = {};\nconst updatedWorkers = [...body.workers];\n\n// Handle leader first (if present) - check both locations\nlet leaderTasks = body.task.params.leader || body.task.params.tasks.leader;\n\nif (leaderTasks) {\n  const leaderName = body.leader;\n  \n  const updatedTasks = leaderTasks.map(task => ({\n    ...task,\n    params: {\n      ...task.params,\n      workerName: leaderName\n    }\n  }));\n  \n  remappedTasks[leaderName] = updatedTasks;\n  \n  // Add leader to workers list if not already there\n  const leaderExists = updatedWorkers.some(w => w.name === leaderName);\n  if (!leaderExists) {\n    updatedWorkers.unshift({\n      name: leaderName,\n      port: body.leaderPort|| 4001  // Leader's API port\n    });\n  }\n}\n\n// Handle regular workers\nbody.workers.forEach((worker, index) => {\n  const workerKey = `worker${index + 1}`;\n  const actualName = worker.name;\n  \n  if (body.task.params.tasks[workerKey]) {\n    const tasks = body.task.params.tasks[workerKey];\n    \n    const updatedTasks = tasks.map(task => ({\n      ...task,\n      params: {\n        ...task.params,\n        workerName: actualName\n      }\n    }));\n    \n    remappedTasks[actualName] = updatedTasks;\n  }\n});\n\nreturn {\n  json: {\n    conversationId: body.conversationId,\n    sessionId: body.sessionId,\n    tasks: remappedTasks,\n    workers: updatedWorkers,\n    leader: body.leader\n  }\n};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-1248,768],"id":"6fc2166b-9036-4df2-9818-0a7ae0e21f3f","name":"Code in JavaScript"},{"parameters":{"content":"## Allowed Actions for Collaborative Tasks\n","height":1056,"width":528},"type":"n8n-nodes-base.stickyNote","position":[336,-416],"typeVersion":1,"id":"d5536c54-8c4b-442f-8ffd-f3b6a52ba4fe","name":"Sticky Note"},{"parameters":{"assignments":{"assignments":[{"id":"787b0bad-c0f3-48f5-8683-ab09