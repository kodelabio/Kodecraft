        {
            "id": "eee067be-ee60-4089-86d4-94ad3c7a9809",
            "name": "Stages List",
            "type": "n8n-nodes-base.code",
            "position": [
                -448,
                80
            ],
            "parameters": {
                "jsCode": "// Convert Planner stages dictionary to array format\n// Input: stages = { \"1\": {stageNumber, stageTitle, Worker1, Worker2, ...}, \"2\": {...} }\n// Output: stagesArray = [{ stageNumber: 1, tasks: [...]}, ...]\n// PORT MAPPING: Uses actual spawned worker ports instead of planner-assumed ports\n\nconst input = $input.first().json.body;\nconst stages = input.stages;\nconst sessionId = input.sessionId;\nconst workers = input.workers || [];\n\nif (!stages || typeof stages !== 'object') {\n  throw new Error('No stages dictionary found in input');\n}\n\n// Create port mapping from actual spawned workers\nconst workerPortMap = {};\nworkers.forEach(w => {\n  workerPortMap[w.workerName] = w.port;\n  console.log(`📍 ${w.workerName}: actual port ${w.port}`);\n});\n\n// Convert dictionary to sorted array\nconst stagesArray = Object.keys(stages)\n  .sort((a, b) => parseInt(a) - parseInt(b))  // Sort numerically: \"1\", \"2\", \"3\"...\n  .map(stageKey => {\n    const stage = stages[stageKey];\n    \n    // Extract worker tasks - worker names are direct keys on stage\n    // Filter out metadata keys: stageNumber, stageTitle, status, startTime, completedCount\n    const workerKeys = Object.keys(stage)\n      .filter(key => \n        key !== 'stageNumber' && \n        key !== 'stageTitle' && \n        key !== 'status' && \n        key !== 'startTime' && \n        key !== 'completedCount'\n      );\n    \n    const tasksArray = workerKeys\n      .map(workerName => {\n        const task = stage[workerName];\n        \n        // Use actual port from spawned workers, fallback to planner port\n        const actualPort = workerPortMap[workerName] || task.port;\n        const portSource = workerPortMap[workerName] ? 'actual' : 'planner';\n        \n        console.log(`  ${workerName}: port ${actualPort} (${portSource})`);\n        \n        return {\n          sessionId: sessionId,\n          stageNumber: stage.stageNumber,\n          worker: workerName,\n          port: actualPort,  // ← Use actual port from spawned workers\n          taskPrompt: task.fullPrompt,\n          coordinates: task.coordinates,\n          status: task.status || 'queued'\n        };\n      });\n    \n    return {\n      stageNumber: stage.stageNumber,\n      stageTitle: stage.stageTitle,\n      status: stage.status || 'not-started',\n      taskCount: tasksArray.length,\n      tasks: tasksArray  // Now as array instead of dict\n    };\n  });\n\nconsole.log(`\\n✅ Converted ${stagesArray.length} stages with correct worker ports`);\nstagesArray.forEach(stage => {\n  console.log(`Stage ${stage.stageNumber} (${stage.stageTitle}): ${stage.taskCount} workers`);\n  stage.tasks.forEach(task => {\n    console.log(`  - ${task.worker} → port ${task.port}`);\n  });\n});\n\nreturn { \n  stagesArray: stagesArray,\n  totalStages: stagesArray.length,\n  sessionId: sessionId\n};"
            },
            "typeVersion": 2
        },
