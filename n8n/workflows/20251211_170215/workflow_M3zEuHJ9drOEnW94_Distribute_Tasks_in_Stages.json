{"id":"M3zEuHJ9drOEnW94","name":"Distribute Tasks in Stages","nodes":[{"parameters":{"httpMethod":"POST","path":"/kodecraft/distribute-tasks-stages","options":{}},"id":"d7a37764-9f00-4543-af93-40556a894a2f","name":"Webhook","type":"n8n-nodes-base.webhook","position":[-672,80],"webhookId":"25bc15a7-f0ca-43fe-b603-d1517c32f5ba","typeVersion":2.1},{"parameters":{"method":"POST","url":"={{ $env.KODECRAFT_SERVER_URL }}/api/orchestration/send-task-stage","sendBody":true,"bodyParameters":{"parameters":[{"name":"port","value":"={{ $json.port }}"},{"name":"taskPrompt","value":"={{ $json.taskPrompt }}"},{"name":"conversationId","value":"={{ $('Webhook').item.json.body.conversationId }}"},{"name":"worker","value":"={{ $json.worker }}"},{"name":"stageNumber","value":"={{ $json.stageNumber }}"},{"name":"callbackWebhookUrl","value":"={{ $env.WEBHOOK_URL }}/webhook/kodecraft/worker-stage-complete"},{"name":"sessionId","value":"={{ $json.sessionId }}"}]},"options":{"timeout":900000}},"id":"665e4660-e4a7-41e9-b20c-47b6fad7592d","name":"Send Task","type":"n8n-nodes-base.httpRequest","position":[1792,96],"retryOnFail":true,"typeVersion":4.3},{"parameters":{"options":{}},"id":"0e5298ed-11d1-42d9-82ba-dbc8c31da8b0","name":"Respond to Webhook","type":"n8n-nodes-base.respondToWebhook","position":[448,-48],"typeVersion":1.4},{"parameters":{"jsCode":"const stages = $input.first().json.body.stages;\nconst stagesArray = Object.keys(stages)\n  .sort((a, b) => parseInt(a) - parseInt(b))\n  .map(stageKey => {\n    const stage = stages[stageKey];\n    const workers = Object.keys(stage.tasks).map(workerName => {\n      const task = stage.tasks[workerName];\n      return {\n        sessionId: $input.first().json.body.sessionId,\n        stageNumber: stage.stageNumber,\n        worker: workerName,\n        port: task.port,\n        taskPrompt: task.fullPrompt\n      };\n    });\n    return {\n      stageNumber: stage.stageNumber,\n      status: stage.status,\n      tasks: workers  // Now as array instead of dict\n    };\n  });\n\nreturn { stagesArray };"},"id":"eee067be-ee60-4089-86d4-94ad3c7a9809","name":"Stages List","type":"n8n-nodes-base.code","position":[-448,80],"typeVersion":2},{"parameters":{"fieldToSplitOut":"stagesArray","options":{}},"id":"2e378c79-480d-468b-9fe8-5df0ce613721","name":"Split Stages","type":"n8n-nodes-base.splitOut","position":[-224,80],"typeVersion":1},{"parameters":{"options":{}},"id":"5c09818d-a2a9-4e3a-89a2-ed0fa3a6d95b","name":"Loop Over Items","type":"n8n-nodes-base.splitInBatches","position":[0,80],"typeVersion":3},{"parameters":{"chatId":"={{ $('Webhook').item.json.body.conversationId }}","text":"=Starting Worker {{ $('Split Workers').item.json.worker }} on stage {{ $('Split Workers').item.json.stageNumber }}..","additionalFields":{"parse_mode":"HTML"}},"id":"6e9c1868-bae0-44ba-a8c6-1b57c24b6cc0","name":"Start Stage","type":"n8n-nodes-base.telegram","position":[2464,96],"webhookId":"523b2d8a-44ab-4b9e-b67f-4faae79f75fc","typeVersion":1.2,"credentials":{"telegramApi":{"id":"AwjqMNsLyFWQwz9w","name":"Telegram account"}}},{"parameters":{"fieldToSplitOut":"tasks","options":{}},"id":"fe3ec374-1b57-4ab5-a67f-5fadc06ea4da","name":"Split Workers","type":"n8n-nodes-base.splitOut","position":[1568,96],"typeVersion":1},{"parameters":{"operation":"update","collection":"CollaborativeTasks","updateKey":"sessionId","fields":"conversationId, sessionId, location, buildRequest, location, workerCount, stages, completedStages, startTime","options":{}},"id":"0776decb-55ec-404f-bb09-fc7cfeb5a29a","name":"Update Tasks Request","type":"n8n-nodes-base.mongoDb","position":[-672,-224],"typeVersion":1.2,"credentials":{"mongoDb":{"id":"lgFVWhuqW6T2Dubq","name":"MongoDB account"}},"disabled":true},{"parameters":{"assignments":{"assignments":[{"id":"2082892d-1066-4f03-bb74-00af9befd498","name":"sessionId","type":"string","value":"={{ $('Webhook').item.json.body.sessionId }}"},{"id":"1923c62e-4fa3-462f-9b05-ccf80f886ca2","name":"stageNumber","type":"number",