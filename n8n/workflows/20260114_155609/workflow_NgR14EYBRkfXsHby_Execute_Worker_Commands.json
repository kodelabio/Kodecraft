        {
            "id": "707cd091-0efc-43e7-aa92-5c648c37a722",
            "name": "Format Results",
            "type": "n8n-nodes-base.code",
            "position": [
                256,
                -160
            ],
            "parameters": {
                "mode": "runOnceForEachItem",
                "jsCode": "const item = $input.item.json;\nconst output = item.output || [];\n\nconst results = {\n  total: output.length,\n  successful: 0,\n  failed: 0,\n  errors: [],\n  successes: []\n};\n\noutput.forEach((result, index) => {\n  if (result.error) {\n    results.failed++;\n    results.errors.push({\n      index: index,\n      message: result.error.message,\n      code: result.error.code,\n      status: result.error.status\n    });\n  } else if (result.success) {\n    results.successful++;\n    results.successes.push({\n      index: index,\n      message: result.message\n    });\n  }\n});\n\nreturn {\n  summary: results,\n  allSucceeded: results.failed === 0,\n  allFailed: results.successful === 0\n};"
            },
            "executeOnce": false,
            "typeVersion": 2
        },
