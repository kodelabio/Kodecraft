            "parameters": {
                "jsCode": "// Now get the document (must come from previous MongoDB read or Set node)\nconst currentStage = $('Webhook').first().json.body.result.taskId.match(/stage(\\d+)/)[1];\nconst doc = $('Worker Status Update').first().json.data;\n\nif (!doc.stages || !doc.stages[currentStage]) {\n  return {\n    stageNumber: currentStage,\n    canProceed: false,\n    reason: `Stage ${currentStage} not found`\n  };\n}\n\nconst currentStageData = doc.stages[currentStage];\nconst workers = Object.keys(currentStageData.tasks);\n\nconst allComplete = workers.every(w => \n  currentStageData.tasks[w].status === \"completed\"\n);\n\nreturn {\n  stageCompleted: allComplete,\n  currentStage: currentStage,\n  completedWorkers: workers.filter(w => currentStageData.tasks[w].status === \"completed\").length,\n  totalWorkers: workers.length\n};"
            },
