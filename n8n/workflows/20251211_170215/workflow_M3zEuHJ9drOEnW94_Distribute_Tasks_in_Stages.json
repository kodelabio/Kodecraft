2e-485c-8f37-945cca5b51bd","typeVersion":1.1},{"parameters":{"jsCode":"// Get stage number from current loop item\nconst currentStage = $('Loop Over Items').first().json.stageNumber;\nconst previousStage = currentStage - 1;\nconst sessionId = $input.first().json.sessionId;\n\nif (currentStage === 1) {\n  return {\n    sessionId: sessionId,\n    stageNumber: 1, \n    canProceed: true,\n    reason: \"First stage\"\n  };\n}\n\n// Now get the document (must come from previous MongoDB read or Set node)\nconst doc = $input.first().json;\n\nif (!doc.stages || !doc.stages[previousStage]) {\n  return {\n    stageNumber: currentStage,\n    canProceed: false,\n    reason: `Stage ${previousStage} not found`\n  };\n}\n\nconst previousStageData = doc.stages[previousStage];\nconst workers = Object.keys(previousStageData.tasks);\n\n//const allComplete = workers.every(w => \n//  previousStageData.tasks[w].status === \"completed\"\n//);\nconst allComplete = previousStageData.status === \"completed\";\n\nreturn {\n  sessionId: sessionId,\n  canProceed: allComplete,\n  previousStage: previousStage,\n  stageNumber: currentStage,\n  completedWorkers: workers.filter(w => previousStageData.tasks[w].status === \"completed\").length,\n  totalWorkers: workers.length\n};\n"},"id":"8894a786-500d-40bc-be18-29fd1807e2a7","name":"Code in JavaScript","type":"n8n-nodes-base.code","position":[448,192],"typeVersion":2},{"parameters":{"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"or","conditions":[{"id":"2567a554-030d-4fa0-afd3-89e9315e65cd","operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.canProceed }}","rightValue":"1"}]},"options":{}},"id":"f4b57c16-a458-49ab-ba23-19bbbf28de44","name":"Proceed?","type":"n8n-nodes-base.if","position":[672,192],"typeVersion":2.2},{"parameters":{"operation":"update","collection":"CollaborativeTasks","query":"={\"sessionId\":\"{{ $json.sessionId }}\"}","update":