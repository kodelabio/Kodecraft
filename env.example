# .env (UPDATED for Multi-User Bot Architecture)
# Configuration for Telegram multi-user bot gateway

# ============================================================
# GATEWAY CONFIGURATION
# ============================================================

# Main gateway port (was single leader bot before, now routes to 5000+)
LEADER_BOT_PORT=4001

# ============================================================
# MULTI-USER LEADER BOT CONFIGURATION (NEW)
# ============================================================

# Base port for spawning individual user leader bots
# Each user gets a bot on port 5000, 5001, 5002, etc.
LEADER_BOT_BASE_PORT=5000

# Maximum number of concurrent user leader bots
# Each bot + workers takes ~450MB memory
# Adjust based on your server capacity
# For 8GB server: use 10-15
# For 32GB server: use 50
MAX_LEADER_BOTS=50

# Time before idle bot is cleaned up (milliseconds)
# Bots not used for this long are killed and removed from memory
# 3600000 = 1 hour
# 1800000 = 30 minutes
LEADER_BOT_IDLE_TIMEOUT=3600000

# ============================================================
# MINECRAFT SERVER CONFIGURATION (EXISTING)
# ============================================================

# Where the Minecraft server is running
MINECRAFT_HOST=localhost
MINECRAFT_PORT=25565

# ============================================================
# TELEGRAM CONFIGURATION (EXISTING)
# ============================================================

# Telegram bot token from @BotFather
# Get this from: https://t.me/BotFather
# Command: /newbot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Your domain where the bot is hosted (for webhook)
# Example: https://mybot.example.com
TELEGRAM_WEBHOOK_URL=https://yourdomain.com

# ============================================================
# n8n WEBHOOK CONFIGURATION (EXISTING)
# ============================================================

# Webhook URL for worker completion callbacks
# Workers call this URL when they finish a task
N8N_WEBHOOK_URL=http://localhost:5678/webhook/worker

# Webhook URL for stage task completion
# Called when a stage task finishes (optional, for advanced flows)
N8N_WEBHOOK_URL_STAGE_COMPLETE=http://localhost:5678/webhook/task-complete

# ============================================================
# DATABASE CONFIGURATION (NEW)
# ============================================================

MONGODB_URI=mongodb://localhost:27017/minecraft-bots
ENCRYPTION_KEY=your-secure-key-min-32-chars

# Encryption key for storing Minecraft passwords securely
# Generate a random string: openssl rand -hex 32
# Or: head -c 32 /dev/urandom | base64
# CRITICAL: Change this to a secure random key!
# Min 32 characters recommended
ENCRYPTION_KEY=your-secure-encryption-key-min-32-chars

# ============================================================
# LOGGING & DEBUG (OPTIONAL)
# ============================================================

# Log level: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info

# Enable detailed request logging
DEBUG_REQUESTS=false

# ============================================================
# DEVELOPMENT vs PRODUCTION
# ============================================================

# Set to 'production' for production deployments
NODE_ENV=development

# ============================================================
# OPTIONAL: RATE LIMITING (TODO)
# ============================================================

# Max API requests per user per minute
# RATE_LIMIT_PER_USER=60

# Max concurrent builds per user
# MAX_BUILDS_PER_USER=3

# Max workers per build
# MAX_WORKERS_PER_BUILD=10

# ============================================================
# OPTIONAL: MONITORING (TODO)
# ============================================================

# Enable Prometheus metrics endpoint
# ENABLE_METRICS=false

# Metrics port
# METRICS_PORT=9090
