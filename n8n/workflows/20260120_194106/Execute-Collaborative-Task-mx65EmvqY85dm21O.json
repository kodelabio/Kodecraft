alName = worker.name;\n    \n    const updatedTasks = tasks.map(task => ({\n      ...task,\n      params: {\n        ...task.params,\n        workerName: actualName\n      }\n    }));\n    \n    remappedTasks.workers[actualName] = updatedTasks;\n  }\n});\n\nreturn {\n  json: {\n    conversationId: body.conversationId,\n    sessionId: body.sessionId,\n    tasks: remappedTasks,\n    workers: updatedWorkers,\n    leader: body.leader\n  }\n};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-1392,688],"id":"6fc2166b-9036-4df2-9818-0a7ae0e21f3f","name":"Code in JavaScript"},{"parameters":{"content":"## All action independently\n","height":1056,"width":528},"type":"n8n-nodes-base.stickyNote","position":[336,160],"typeVersion":1,"id":"d5536c54-8c4b-442f-8ffd-f3b6a52ba4fe","name":"Sticky Note"},{"parameters":{"assignments":{"assignments":[{"id":"787b0bad-c0f3-48f5-8683-ab095a8acecb","name":"tasks","value":"={{ $('Workers/Tasks').item.json.tasks[$json.name] }}","type":"array"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-352,800],"id":"0fb4e706-bfd2-491e-a307-0733d364ab07","name":"Worker Tasks"},{"parameters":{"assignments":{"assignments":[{"id":"9dff12b3-e600-460c-81ec-fd55dff50eb9","name":"=workers","value":"={{ $json.workers }}","type":"array"},{"id":"85bad55a-8e87-4078-87a8-a8ee2857648f","name":"tasks","value":"={{ $json.tasks }}","type":"object"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-736,896],"id":"683efdf5-0960-44d7-9f65-ee33ab7bd3af","name":"Workers/Tasks"},{"parameters":{"fieldToSplitOut":"workers","options":{}},"type":"n8n-nodes-base.splitOut","typeVersion":1,"position":[-576,800],"id":"2b8b93d0-0ea3-46ac-9eea-27d1f5603f1c","name":"Split Workers"},{"parameters":{"fieldToSplitOut":"tasks","options":{}},"type":"n8n-nodes-base.splitOut","typeVersion":1,"position":[-128,800],"id":"05b39174-3655-47f5-a164-5ce49a42d990","name":"Split Tasks"},{"parameters":{"method":"POST","url":"={{$env.KODECRAFT