        {
            "id": "b8886104-a10d-4db4-bdf8-bf8c28f92608",
            "name": "Parse Plan",
            "type": "n8n-nodes-base.code",
            "position": [
                -112,
                16
            ],
            "parameters": {
                "jsCode": "// Get the output string from the previous node\nconst outputString = $input.first().json.output;\n\nconsole.log('Raw output:', outputString);\n\ntry {\n  let parsedData;\n  \n  // Try to parse directly as JSON first\n  try {\n    parsedData = JSON.parse(outputString);\n    console.log('Parsed as direct JSON');\n  } catch (e) {\n    // If direct parsing fails, try to extract JSON from code blocks\n    \n    // Match various code block formats: ```json ... ```, ```...```, or just raw JSON\n    const codeBlockMatch = outputString.match(/```(?:json)?\\s*([\\s\\S]*?)\\s*```/);\n    \n    if (codeBlockMatch && codeBlockMatch[1]) {\n      console.log('Extracted from code block');\n      parsedData = JSON.parse(codeBlockMatch[1]);\n    } else {\n      // Try to find JSON object/array patterns in the string\n      const jsonMatch = outputString.match(/(\\{[\\s\\S]*\\}|\\[[\\s\\S]*\\])/);\n      \n      if (jsonMatch) {\n        console.log('Extracted JSON pattern');\n        parsedData = JSON.parse(jsonMatch[1]);\n      } else {\n        throw new Error('No JSON found in output');\n      }\n    }\n  }\n  \n  console.log('Parsed data:', JSON.stringify(parsedData, null, 2));\n  \n  // Return the parsed data as-is (generic, no assumptions about structure)\n  return {\n    plan: parsedData\n  };\n  \n} catch (error) {\n  console.log('Error parsing JSON:', error.message);\n  return [{\n    json: {\n      error: 'Failed to parse JSON',\n      message: error.message,\n      rawOutput: outputString\n    }\n  }];\n}"
            },
            "typeVersion": 2
        },
