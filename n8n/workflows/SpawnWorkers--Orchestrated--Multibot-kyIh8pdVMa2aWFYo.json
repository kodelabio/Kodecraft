SDP9Z6t0aXMB","name":"Minecraft"}},"disabled":true},{"parameters":{"fieldToSplitOut":"workers","options":{}},"type":"n8n-nodes-base.splitOut","typeVersion":1,"position":[704,-16],"id":"f024d3b5-e4a7-4b0b-b75b-4ec71f125dcc","name":"Split Out"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"2ba0241f-6807-4a10-b4e1-1c4d3cc0ad0c","leftValue":"={{ $json.spawned }}","rightValue":0,"operator":{"type":"number","operation":"gt"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[-192,208],"id":"13ea9f31-68f3-417d-b78a-40e3d12ea064","name":"If"},{"parameters":{"respondWith":"json","responseBody":"{\n  \"error\": \"Failed to spawn workers\"\n}","options":{"responseCode":500}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.4,"position":[32,304],"id":"1cdf5d99-d3a1-4b97-bc1b-a5c6801a6f55","name":"Respond to Webhook1"},{"parameters":{"method":"POST","url":"={{$env.KODECRAFT_SERVER_URL}}/api/orchestration/{{ $('Webhook').item.json.body.conversationId }}/register-workers","sendBody":true,"bodyParameters":{"parameters":[{"name":"sessionId","value":"={{ $('Webhook').item.json.body.sessionId }}"},{"name":"workers","value":"={{ $json.workers }}"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[480,-16],"id":"f8565967-6553-475d-9fa4-4d5b5a1ee2b7","name":"Register Workers"},{"parameters":{"amount":2},"type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[480,208],"id":"b29bd258-f626-41d8-a3bb-dfe73cd94f29","name":"Wait","webhookId":"6764ebd6-8249-46e6-abfd-f5a1ec4464cd"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"24ce174b-edd5-4e38-a8aa-9a2856abf784","leftValue":"={{ $json.allReady }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[256,32],"id":"bdf02ae0-4c19-44cf-bc52-39a26549791a","name":"If1"},{"parameters":{"method":"POST","url":"={{ $env.KODECRAFT_SERVER_URL}}/api/orchestration/{{ $('Webhook').item.json.body.conversationId }}/wait-workers","sendBody":true,"bodyParameters":{"parameters":[{"name":"workers","value":"={{ $('Spawn workers').item.json.results.map(w => ({name: w.workerName, port: w.port}))}}"},{"name":"timeoutMs","value":"30000"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[32,112],"id":"65ee93bd-bea1-40ab-98f4-2349648955d3","name":"Wait Workers"},{"parameters":{"content":"### Wait Workers (Summary)\nPolls worker health endpoints to verify they're online and ready to receive commands. It doesn't do any work itself—it just \"knocks on the door\" of each worker repeatedly until they answer or timeout.Think of it as: \"Is anyone home? Is anyone home? Is anyone home?\" (asks every 500ms until they respond or 30 seconds pass)\n\n#### TL;DR\n/api/orchestration/wait-workers = \"Are all the worker processes actually online and responding to requests?\"\n\nPolls each worker's /api/health endpoint\nWaits up to 30 seconds for them to respond\nChecks every 500ms to be responsive\nChecks in parallel (fast)\nReturns success even if some fail (soft fail)\nUsed right after spawning to verify workers booted properly\n\nIt's the \"health check before proceeding\" step! ✅","height":784,"width":272,"color":4},"type":"n8n-nodes-base.stickyNote","position":[-64,-528],"typeVersion":1,"id":"d162c15f-c9d2-4596-a351-883c6b25b6ef","name":"Sticky Note1"},{"parameters":{"content":"### Register Workers (Summary)\n\nLinks spawned workers to a build session. It's the \"add these workers to this team/project\" operation. This creates the association: \"These 3 workers belong to build session XYZ\"\nThink of it as: \"I have 3 workers and a build session. Connect them together.\"\n\n\n####TL;DR\n\n/api/orchestration/register-workers = \"Associate these workers with this build session\"\n\nRequires: Session to exist (404 if not)\nDoes: Links workers list to session, updates statuses\nChanges: Session status → workers_assigned, Worker status → assigned\nBlocks: No (instant operation)\nUsed after: wait-workers (workers are ready)\nUsed before: reserve-location (need workers in session to position them)\n\nIt's the \"Team formation\" step! ✅","height":800,"width":272,"color":4},"type":"n8n-nodes-base.stickyNote","position":[400,-656],"typeVersion":1,"id":"af032e32-4330-4952-b2bd-fe46cb0e37ca","name":"Sticky Note3"},{"parameters":{"method":"POST","url":"={{$env.KODECRAFT_SERVER_URL}}/api/orchestration/{{ $('Webhook').item.json.body.conversationId }}/move-worker-to-player","sendBody":true,"bodyParameters":{"parameters":[{"name":"workerName","value":"={{ $json.workerName}}"},{"name":"playerName","value":"={{ $('Webhook').item.json.body.leader }}"},{"name":"distance","value":"={{ Math.floor(Math.random() * 3) + 1 }}"},{"name":"playerPosition","value":"={{ $('Webhook').item.json.body.leaderPositionn }}"}]},"options":{"timeout":30000}},"name":"Execute MoveWorkertoLeader","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[928,-16],"id":"57ff24e0-5783-4eb3-b0f2-a433e8397bbe","continueOnFail":true}],"connections":{"Webhook":{"main":[[{"node":"Spawn workers","type":"main","index":0}]]},"Spawn workers":{"main":[[{"node":"If","type":"main","index":0}],[]]},"Aggregate":{"main":[[{"node":"Respond to Webhook","type":"main","index":0}]]},"Update Workers Status":{"main":[[]]},"Split Out":{"main":[[{"node":"Execute MoveWorkertoLeader","type":"main","index":0}]]},"If":{"main":[[{"node":"Wait Workers","type":"main","index":0}],[{"node":"Respond to Webhook1","type":"main","index":0}]]},"Register Workers":{"main":[[{"node":"Split Out","type":"main","index":0}]]},"If1":{"main":[[{"node":"Register Workers","type":"main","index":0}],[{"node":"Wait","type":"main","index":0}]]},"Wait Workers":{"main":[[{"node":"If1","type":"main","index":0}]]},"Wait":{"main":[[{"node":"Wait Workers","type":"main","index":0}]]},"Execute MoveWorkertoLeader":{"main":[[{"node":"Aggregate","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"staticData":null,"meta":null,"pinData":{"Webhook":[{"json":{"headers":{"host":"svdev-avatar.kodelab.io","x-real-ip":"3.10.173.248","x-forwarded-for":"3.10.173.248","x-forwarded-proto":"https","connection":"close","content-length":"172","accept":"application/json,text/html,application/xhtml+xml,application/xml,text/*;q=0.9, image/*;q=0.8, */*;q=0.7","content-type":"application/json","user-agent":"axios/1.12.0","accept-encoding":"gzip, compress, deflate, br"},"params":{},"query":{},"body":{"workercount":4,"sessionId":"spawn_1769450307048","conversationId":5415489232,"leader":"TheBoss","leaderPositionn":{"x":606.4846080789688,"y":-60,"z":-340.40663000249197}},"webhookUrl":"https://svdev-avatar.kodelab.io/webhook/kodecraft/multibot/spawn-workers","executionMode":"production"},"pairedItem":{"item":0}}]},"versionId":"dd7ef6aa-452d-44cd-8fd3-106f45644b7e","activeVersionId":"dd7ef6aa-452d-44cd-8fd3-106f45644b7e","versionCounter":101,"triggerCount":1,"tags":[{"updatedAt":"2026-01-15T12:30:29.478Z","createdAt":"2026-01-15T12:30:29.478Z","id":"mwusLyb64tONfLDq","name":"#kodecraft"}],"shared":[{"updatedAt":"2025-12-14T15:25:26.015Z","createdAt":"2025-12-14T15:25:26.015Z","role":"workflow:owner","workflowId":"kyIh8pdVMa2aWFYo","projectId":"RXobmFXaajAvtGNa","project":{"updatedAt":"2025-03-20T15:18:45.099Z","createdAt":"2025-03-20T15:18:06.857Z","id":"RXobmFXaajAvtGNa","name":"Maurizio Santamicone <maurizio@kodelab.io>","type":"personal","icon":null,"description":null,"creatorId":"178145f9-e5e9-4e36-b3ba-223b2d8848d5"}}]}]