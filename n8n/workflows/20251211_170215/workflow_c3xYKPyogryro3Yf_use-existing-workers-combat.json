{"id":"c3xYKPyogryro3Yf","name":"use-existing-workers-combat","nodes":[{"parameters":{"httpMethod":"POST","path":"kodecraft/use-existing-workers-combat","responseMode":"responseNode","options":{}},"id":"a0ed801b-b99d-42b3-abde-032c767655ed","name":"Webhook","type":"n8n-nodes-base.webhook","position":[-2096,-80],"webhookId":"f0fef20e-f5b4-490c-b0b1-93da057c4323","typeVersion":2.1},{"parameters":{"respondWith":"json","responseBody":"={\n     \"sessionId\": \"{{ $('Set Combat Request').item.json.sessionId }}\",\n     \"status\": \"build_started\",\n     \"message\": \"Build orchestration started\",\n     \"workerCount\": {{ $input.all().length}}\n   } ","options":{}},"id":"5b6f0b32-3c3a-4774-857e-149c27e550fa","name":"Respond to Webhook","type":"n8n-nodes-base.respondToWebhook","position":[-576,-112],"typeVersion":1.4},{"parameters":{"respondWith":"json","responseBody":"={\n     \"sessionId\": \"{{ $('Set Combat Request').item.json.sessionId }}\",\n     \"status\": \"failed\",\n     \"message\": \"Failed to build: {{$json.error_message}}\",\n     \"workerCount\": 0\n   } ","options":{}},"id":"0870d1b5-277b-4113-84a3-42d7324f2cc2","name":"Failed to Build","type":"n8n-nodes-base.respondToWebhook","position":[-576,96],"typeVersion":1.4},{"parameters":{"assignments":{"assignments":[{"id":"5ee4c036-c158-407f-9d91-f3da2febc635","name":"combatRequest","type":"string","value":"={{ $json.body.combatRequest }}"},{"id":"a21e4b01-56a5-4934-a098-22b812c04310","name":"soldierCount","type":"string","value":"={{ $json.body.soldierCount }}"},{"id":"ec7ee5cf-7f84-43e3-8e97-055246d8c1c7","name":"taskDivision","type":"object","value":"={{ typeof $json.body.taskDivision === 'string' ? JSON.parse($json.body.taskDivision) : $json.body.taskDivision }}"},{"id":"2e673979-3791-49d1-b87c-df3ac1ffce81","name":"conversationId","type":"string","value":"={{ $json.body.conversationId }}"},{"id":"ffe05833-2558-4c83-9a84-95b77050214d","name":"username","type":"string","value":"={{ $json.body.username }}"},{"id":"c6ac0434-0dcf-4be7-9b62-7dac7310af30","name":"botStatus","type":"object","value":"={{ $json.body.botStatus }}"},{"id":"019464d5-07ac-4a47-8d2e-664e5fa1b5aa","name":"status","type":"string","value":"pending"},{"id":"67732f2a-1220-4c6b-bfaa-d8a8daac2e98","name":"completedWorkers","type":"number","value":"={{ 0 }}"},{"id":"729a1d6a-0319-4b9d-a6b2-a78a54ff2f27","name":"startTime","type":"string","value":"={{ $now }}"},{"id":"ccb2ceb2-ec33-4ca9-9f8f-ab9ddc15fe60","name":"workersStatus","type":"object","value":"={{Object.fromEntries(Object.keys($json.body.taskDivision).map(key => [key, \"not-started\"]))}}"},{"id":"2142bc2e-8160-409f-ac91-3298c4162ac7","name":"sessionId","type":"string","value":"={{\"combat_\" + new Date().getTime()}}"},{"id":"b976d07a-a355-4428-8dbe-3d9512b1d8a8","name":"callbackWebhookUrl","type":"string","value":"={{ $('Webhook').item.json.body.callbackWebhookUrl }}"},{"id":"99e38808-d413-4d58-ae62-98531c166b1e","name":"location","type":"string","value":"={{ $json.body.location }}"}]},"options":{}},"id":"99e3df2a-df44-44b9-b20b-8d0aadd77d10","name":"Set Combat Request","type":"n8n-nodes-base.set","position":[-1840,-80],"typeVersion":3.4},{"parameters":{"operation":"insert","collection":"CollaborativeCombat","fields":"conversationId, sessionId, username, botStatus, combatRequest, location, soldierCount, taskDivision, status, workersStatus, completedWorkers, startTime","options":{}},"id":"165cc003-0d19-4ef4-a73b-5c5d1b0a9130","name":"Store Combat Request","type":"n8n-nodes-base.mongoDb","position":[-1648,-80],"typeVersion":1.2,"credentials":{"mongoDb":{"id":"lgFVWhuqW6T2Dubq","name":"MongoDB account"}}},{"parameters":{"method":"POST","url":"={{ $env.WEBHOOK_URL }}/webhook/kodecraft/coordinate-combat","sendBody":true,"bodyParameters":{"parameters":[{"name":"=workerCount","value":"={{ $json.soldierCount }}"},{"name":"taskDivision","value":"={{ $('Webhook').item.json.body.taskDivision }}"},{"name":"combatRequest","value":"={{ $('Webhook').item.json.body.combatRequest }}"},{"name":"location","value":"={{ $('Webhook').item.json.body.location }}"},{"name":"conversationId","value":"={{ $('Webhook').item.json.body.conversationId }}"},{"name":"soldiers","value":"={{ $json.soldiers }}"},{"name":"sessionId","value":"={{ $('Webhook').item.json.body.sessionId }}"}]},"options":{}},"id":"cdc9bc1f-26a8-41e3-81b8-1cefa5bbd1d3","name":"CoordinateCombat","type":"n8n-nodes-base.httpRequest","position":[-992,-80],"typeVersion":4.3,"onError":"continueErrorOutput"},{"parameters":{"jsCode":"// Get Set Combat Request data\nconst combatData = $('Set Combat Request').first().json;\nconst taskDivision = combatData.taskDivision || {};\nconst neededSoldiers = Object.keys(taskDivision); // [\"Soldier1\", \"Soldier2\"]\n\n// Get all active workers from Get Existing Workers node\nconst statusResponse = $('Get Existing Workers').first().json;\nconst allWorkers = statusResponse.workers || [];\n\n// Filter to only the workers mentioned in the combat request\nconst matchedWorkers = allWorkers.filter(worker => \n  neededSoldiers.includes(worker.name)\n);\n\n// Check if we found all needed workers\nif (matchedWorkers.length !== neededSoldiers.length) {\n  const missing = neededSoldiers.filter(name => \n    !matchedWorkers.find(w => w.name === name)\n  );\n  throw new Error(`Workers not found: ${missing.join(', ')}. Please spawn them first.`);\n}\n\n// Transform to spawnedWorkers format (matching what WaitAndRegister returns)\nconst spawnedWorkers = matchedWorkers.map(w => ({\n  workerName: w.name,\n  port: w.port,\n  status: 'spawned',\n  message: `Using existing ${w.name}`\n}));\n\nreturn {\n  json: {\n    soldiers: matchedWorkers,\n    spawnedWorkers: spawnedWorkers,\n    soldierCount: matchedWorkers.length,\n    sessionId: combatData.sessionId,\n    combatRequest: combatData.combatRequest,\n    taskDivision: taskDivision,\n    location: combatData.location,\n    username: combatData.username,\n    conversationId: combatData.conversationId\n  }\n};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-1232,-80],"id":"58ed5457-efb3-408f-ab9a-fff413adc63f","name":"Match Soldiers"},{"parameters":{"url":"={{$env.KODECRAFT_SERVER_URL}}/api/orchestration/status","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[-1456,-80],"id":"75223313-c6eb-48d7-b48d-7801c2e237f1","name":"Get Existing Workers"}],"connections":{"Webhook":{"main":[[{"node":"Set Combat Request","type":"main","index":0}]]},"Set Combat Request":{"main":[[{"node":"Store Combat Request","type":"main","index":0}]]},"Store Combat Request":{"main":[[{"node":"Get Existing Workers","type":"main","index":0}]]},"CoordinateCombat":{"main":[[{"node":"Respond to Webhook","type":"main","index":0}],[{"node":"Failed to Build","type":"main","index":0}]]},"Match Soldiers":{"main":[[{"node":"CoordinateCombat","type":"main","index":0}]]},"Get Existing Workers":{"main":[[{"node":"Match Soldiers","type":"main","index":0}]]}},"active":0,"settings":{"executionOrder":"v1"},"staticData":null,"pinData":{},"versionId":"646b2ef2-4ff1-4ceb-acf5-d8a364f309e6","meta":{"templateCredsSetupCompleted":true}}
