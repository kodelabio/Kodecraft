dTasks = leaderTasks.map(task => ({\n      ...task,\n      params: { ...task.params, workerName: leaderName }\n    }));\n    remappedTasks.leader[leaderName] = updatedTasks;\n  } else {\n    remappedTasks.leader[leaderName] = []; // Empty array\n  }\n}\n  \nconst leaderExists = updatedWorkers.some(w => w.name === leaderName);\nif (!leaderExists) {\n  updatedWorkers.unshift({ name: leaderName, port: body.leaderPort || 4001 });\n}\n\n// Handle workers - increment distance by worker index\nlet workerIndex = 0;\nObject.entries(body.task.params.tasks || {}).forEach(([key, tasks]) => {\n  if (key === 'leader') return;\n  \n  const match = key.match(/\\d+$/);\n  if (match) {\n    const index = parseInt(match[0]) - 1;\n    const worker = body.workers[index];\n    \n    if (worker && tasks) {\n      const updatedTasks = tasks.map(task => ({\n        ...task,\n        params: { ...task.params, workerName: worker.name, port:worker.port, distance: (task.params.distance || 0) + workerIndex }\n      }));\n      remappedTasks.workers[worker.name] = updatedTasks;\n      workerIndex++;\n    }\n  }\n});\n\nreturn {\n  json: {\n    conversationId: body.conversationId,\n    sessionId: body.sessionId,\n    tasks: remappedTasks,\n    workers: updatedWorkers,\n    leader: body.leader.name\n  }\n};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-1824,688],"id":"6fc2166b-9036-4df2-9818-0a7ae0e21f3f","name":"Code in JavaScript"},{"parameters":{"content":"## All action independently\n","height":1056,"width":528},"type":"n8n-nodes-base.stickyNote","position":[336,160],"typeVersion":1,"id":"d5536c54-8c4b-442f-8ffd-f3b6a52ba4fe","name":"Sticky Note"},{"parameters":{"assignments":{"assignments":[{"id":"787b0bad-c0f3-48f5-8683-ab095a8acecb","name":"tasks","value":"={{ $('Workers/Tasks').item.json.tasks.leader[$json.name] || $('Workers/Tasks').item.json.tasks.workers[$json.name]}}","type":"array"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-352,800],"id":"