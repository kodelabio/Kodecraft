BRAIN_MODE=external
BOT_NAME=Kodecraft

# ============================================================
# MULTI-USER LEADER BOT CONFIGURATION (NEW)
# ============================================================
# Base port for spawning individual user leader bots
# Each user gets a bot on port 5000, 5001, 5002, etc.


# Maximum number of concurrent user leader bots
# Each bot + workers takes ~450MB memory
# Adjust based on your server capacity
# For 8GB server: use 10-15
# For 32GB server: use 50
MAX_LEADER_BOTS=10
# Time before idle bot is cleaned up (milliseconds)
# Bots not used for this long are killed and removed from memory
# 3600000 = 1 hour
# 1800000 = 30 minutes
LEADER_BOT_IDLE_TIMEOUT=3600000

# ============================================
# Bot Configuration
# ============================================
#  PORTS
API_GATEWAY_PORT=4001
# Leader bot base port (leaders will use 5000, 5001, 5002, etc.)
LEADER_BASE_PORT=5000
# Worker bot starting port (workers will use 6000, 6001, 6002, etc.)
WORKER_BASE_PORT=6001

# Maximum number of worker bots
MAX_WORKERS=5


# ============================================
# Node Environment
# ============================================
NODE_ENV=production
# NODE_ENV=development  # Use for development

# ============================================
# Display/Graphics (for Xvfb)
# ============================================
DISPLAY=:99

# ============================================
# Minecraft Server Configuration
# ============================================
MINECRAFT_HOST=minecraft-server
MINECRAFT_PORT=55916
#MINECRAFT_USERNAME=bot_name
#MINECRAFT_PASSWORD=your_password
MINDSERVER_HOST=mindserver
MINDSERVER_PORT=8080



# ============================================
# Logging
# ============================================
LOG_LEVEL=info
# LOG_LEVEL=debug  # Verbose logging
# LOG_LEVEL=warn
# LOG_LEVEL=error

# ============================================
# Database Configuration (Optional)
# ============================================
# If using PostgreSQL for session tracking
#DB_HOST=postgres
#DB_PORT=5432
#DB_NAME=kodecraft
#DB_USER=kodecraft
#DB_PASSWORD=changeme
# DB_HOST=localhost  # If using host network

# ============================================
# n8n Orchestration (Optional)
# ============================================
# If using n8n for workflow orchestration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
#N8N_USER=admin
#N8N_PASSWORD=changeme
N8N_WEBHOOK_URL=http://172.31.14.250:5678/webhook
N8N_CALLBACK_URL=http://172.31.14.250:5678/webhook/kodecraft/worker-complete

# ============================================
# API Configuration
# ============================================
API_TIMEOUT=30000
API_MAX_RETRIES=3

# ============================================
# Performance Tuning
# ============================================
# Number of parallel tasks per worker
TASKS_PER_WORKER=2

# Timeout for task execution (ms)
TASK_TIMEOUT=300000

# ============================================
# Debug Flags
# ============================================
DEBUG=false
VERBOSE_LOGGING=false
