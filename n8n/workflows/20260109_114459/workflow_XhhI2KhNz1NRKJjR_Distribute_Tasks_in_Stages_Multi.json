        {
            "id": "6463bb0d-34ff-4b97-ae01-2f916f2fa56d",
            "name": "Code in JavaScript",
            "type": "n8n-nodes-base.code",
            "position": [
                448,
                192
            ],
            "parameters": {
                "jsCode": "// Get stage number from current loop item\nconst currentStage = $('Loop Over Items').first().json.stageNumber;\nconst previousStage = currentStage - 1;\nconst sessionId = $input.first().json.sessionId;\n\nif (currentStage === 1) {\n  return {\n    sessionId: sessionId,\n    stageNumber: 1, \n    canProceed: true,\n    reason: \"First stage\"\n  };\n}\n\n// Now get the document (must come from previous MongoDB read or Set node)\nconst doc = $input.first().json;\n\nif (!doc.stages || !doc.stages[previousStage]) {\n  return {\n    stageNumber: currentStage,\n    canProceed: false,\n    reason: `Stage ${previousStage} not found`\n  };\n}\n\nconst previousStageData = doc.stages[previousStage];\nconst workers = Object.keys(previousStageData.tasks);\n\n//const allComplete = workers.every(w => \n//  previousStageData.tasks[w].status === \"completed\"\n//);\nconst allComplete = previousStageData.status === \"completed\";\n\nreturn {\n  sessionId: sessionId,\n  canProceed: allComplete,\n  previousStage: previousStage,\n  stageNumber: currentStage,\n  completedWorkers: workers.filter(w => previousStageData.tasks[w].status === \"completed\").length,\n  totalWorkers: workers.length\n};\n"
            },
            "typeVersion": 2
        },
