s":{"jsCode":"// Now get the document (must come from previous MongoDB read or Set node)\nconst currentStage = $('Webhook').first().json.body.result.taskId.match(/stage(\\d+)/)[1];\nconst doc = $('Worker Status Update').first().json.data;\n\nif (!currentStage || !doc.stages || !doc.stages[currentStage]) {\n  return {\n    stageNumber: currentStage,\n    canProceed: false,\n    reason: `Stage ${currentStage} not found in document`\n  };\n}\n\n\nif (!doc.stages || !doc.stages[currentStage]) {\n  return {\n    stageNumber: currentStage,\n    canProceed: false,\n    reason: `Stage ${currentStage} not found`\n  };\n}\n\nconst currentStageData = doc.stages[currentStage];\n\n// Get worker names (Worker1, Worker2, etc.) - filter out non-worker keys\nconst workers = Object.keys(currentStageData).filter(key => \n  key.startsWith('Worker') && \n  typeof currentStageData[key] === 'object' &&\n  currentStageData[key].status !== undefined\n);\n\n// Check if all workers completed (status === \"completed\")\nconst completedWorkers = workers.filter(w => \n  currentStageData[w].status === \"completed\"\n);\n\nconst allComplete = completedWorkers.length === workers.length;\n\nreturn {\n  stageCompleted: allComplete,\n  canProceed: allComplete,\n  currentStage: currentStage,\n  completedWorkers: completedWorkers,\n  totalWorkers: workers.length,\n  workerStatuses: workers.map(w => ({\n    worker: w,\n    status: currentStageData[w].status\n  })),\n  reason: allComplete ? `Stage ${currentStage} complete` : `Waiting for: ${workers.filter(w => currentStageData[w].status !== \"completed\").join(\", \")}`\n};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1184,-160],"id":"e122feba-e83b-4f00-8ca3-0cf5677d369c","name":"Stage Completed"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"55f0cbe8-297a-485a-9bc4-5aec48acbadb","leftValue":"={{ $json.stageCompleted }}","rightValue":"","operator":{"typ