[{"updatedAt":"2026-02-10T13:48:48.145Z","createdAt":"2026-01-30T15:56:53.290Z","id":"iYhUbBWXmvEmZgk9CeEZM","name":"Allocate Realm","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"/kodecraft/admin/allocate-realm","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-496,192],"id":"80bfcb42-1776-4bda-b452-a9957c4d8850","name":"Webhook","webhookId":"7e2b0530-e7d1-4ca1-9e5c-253c43a6a60c"},{"parameters":{"operation":"insert","collection":"Realms","fields":"realmId, user_id, pr, bounds, realm_size, created_at","options":{}},"type":"n8n-nodes-base.mongoDb","typeVersion":1.2,"position":[1520,0],"id":"c6c302bc-429b-4877-97ba-9cb67f0d4067","name":"Store Realm","credentials":{"mongoDb":{"id":"96R7SDP9Z6t0aXMB","name":"Minecraft"}}},{"parameters":{"url":"={{ $env.KODECRAFT_SERVER_URL }}/api/admin/world-bounds","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[176,192],"id":"1214e07f-a428-4025-a6fd-8802fe4e136f","name":"World Bounds"},{"parameters":{"respondWith":"json","responseBody":"={\n  \"success\": true,\n  \"realm\": {{ JSON.stringify($json) }}\n}","options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[1744,0],"id":"3f3597d2-ad6f-47f3-b3d3-bc1a7e8718ae","name":"Respond to Webhook"},{"parameters":{"jsCode":"const pr = $input.first().json.body.leader_pr_value;\nconst baseSize = 4000;\nconst multiplier = pr / 100;\nreturn {\n  size: Math.floor(baseSize * multiplier)\n}"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-272,192],"id":"f3fb324b-53d6-4162-b433-4591c529237c","name":"Realm Size"},{"parameters":{"collection":"Realms","options":{}},"type":"n8n-nodes-base.mongoDb","typeVersion":1.2,"position":[400,192],"id":"998416b1-b72d-4a04-a62d-2131fa0501e9","name":"Existing Realms","alwaysOutputData":true,"credentials":{"mongoDb":{"id":"96R7SDP9Z6t0aXMB","name":"Minecraft"}}},{"parameters":{"jsCode":"let existingRealms = $input.all()\n  .filter(item => item.json?.realmId)\n  .map(item => item.json);  // Extract just the json part\n\nconst worldBounds = $('World Bounds').first().json.worldBounds\nconst realmSize = $('Realm Size').first().json.size;\nconst padding = 0;\n\nconst debugInfo = {\n    worldBounds,\n    realmSize,\n    padding,\n    existingRealmsCount: existingRealms.length,\n    existingRealms\n};\n\nfunction findAvailableRealmSpace(worldBounds, realmSize, existingRealms) {\n    const { minX, maxX, minZ, maxZ } = worldBounds;\n    \n    let currentX = minX;\n    \n    while (currentX + realmSize <= maxX) {\n        let currentZ = minZ;\n        \n        while (currentZ + realmSize <= maxZ) {\n            const candidateBounds = {\n                minX: currentX,\n                maxX: currentX + realmSize,\n                minZ: currentZ,\n                maxZ: currentZ + realmSize,\n                minY: worldBounds.minY || -64,\n                maxY: worldBounds.maxY || 320\n            };\n            \n            const hasConflict = existingRealms.some(realm => {\n                // Access bounds from nested object\n                const bounds = realm.bounds;\n                const xOverlap = !(candidateBounds.maxX <= bounds.minX ||\n                                  candidateBounds.minX >= bounds.maxX);\n                \n                const zOverlap = !(candidateBounds.maxZ <= bounds.minZ ||\n                                  candidateBounds.minZ >= bounds.maxZ);\n                \n                return xOverlap && zOverlap;\n            });\n            \n            if (!hasConflict) {\n                return { bounds: candidateBounds, iterations: [] };\n            }\n            \n            currentZ += realmSize;\n        }\n        \n        currentX += realmSize;\n    }\n    \n    return { bounds: null, iterations: [] };\n}\n\nconst result = findAvailableRealmSpace(worldBounds, realmSize, existingRealms);\n\nreturn {\n    bounds: result.bounds,\n    debug: debugInfo,\n    iterations: result.iterations\n};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[848,96],"id":"7a45cf98-ff60-459f-b402-ff50cee535b1","name":"Find Realm Space"},{"parameters":{"assignments":{"assignments":[{"id":"5cf66eb0-cd05-427c-8c62-f44c3e4bd4ad","name":"realmId","value":"={{\"Realm_\" +$('Webhook').item.json.body.userId + \"_\" + Date.now()}}","type":"string"},{"id":"82318c9d-bec0-4aa7-8127-cc284a445903","name":"user_id","value":"={{ $('Webhook').item.json.body.userId }}","type":"string"},{"id":"5fbc8d01-ea75-4a0e-92dd-bec7eae93052","name":"pr","value":"={{ $('Webhook').item.json.body.leader_pr_value }}","type":"number"},{"id":"42218706-fb41-4e31-86f8-4a7df2a6904e","name":"bounds","value":"= {{ JSON.stringify($json.bounds) }}","type":"object"},{"id":"28c88f30-2026-4bc7-b16b-b1ffffaa2127","name":"realm_size","value":"={{ $('Realm Size').item.json.size }}","type":"number"},{"id":"b066d3ce-5f93-48a6-b61f-599b16e539bf","name":"created_at","value":"={{$now}}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[1296,0],"id":"7e0b0ab3-f2ec-459c-82e1-d9afe288500d","name":"Set Realm"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"1bd1e26f-8086-4898-9b2f-ba4789c7801a","leftValue":"={{ $json.user_id }}","rightValue":"={{ $('Webhook').item.json.body.userId }}","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.3,"position":[624,192],"id":"94e9769e-09c2-49a8-9213-00b0aa846082","name":"Existing?"},{"parameters":{"respondWith":"json","responseBody":"=  {\"success\":false, \n  \"message\": \"User {{ $json.user_id }} has already realm {{ $json.realmId }} allocated.\"\n} ","options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[848,288],"id":"de70ca9c-cf89-4c80-8231-8bcfede0216e","name":"Respond