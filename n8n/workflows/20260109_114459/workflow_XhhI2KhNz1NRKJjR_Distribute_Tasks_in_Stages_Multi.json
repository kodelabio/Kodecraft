        {
            "id": "859ac19a-3949-45aa-aeae-724467994e2a",
            "name": "Stages List",
            "type": "n8n-nodes-base.code",
            "position": [
                -448,
                80
            ],
            "parameters": {
                "jsCode": "// Convert Planner stages dictionary to array format\n// Maps planner Worker1/Worker2 to actual spawned worker names\n\nconst input = $input.first().json.body;\nconst stages = input.stages;\nconst sessionId = input.sessionId;\nconst workers = input.workers || [];\n\nconsole.log(`🚀 Starting stage conversion for session: ${sessionId}`);\n\nif (!stages || typeof stages !== 'object') {\n  throw new Error('No stages found');\n}\n\nif (!workers || workers.length === 0) {\n  throw new Error('No workers found');\n}\n\n// ===== Build simple worker lookup by index =====\nconst workersByIndex = {};\nworkers.forEach((w, idx) => {\n  workersByIndex[idx] = {\n    name: w.workerName,\n    port: w.port\n  };\n  console.log(`Worker ${idx}: ${w.workerName} on port ${w.port}`);\n});\n\n// ===== Convert stages =====\nconst stagesArray = [];\n\n// Process each stage in numeric order\nconst stageKeys = Object.keys(stages).sort((a, b) => parseInt(a) - parseInt(b));\n\nstageKeys.forEach(stageKeyStr => {\n  const stageNum = parseInt(stageKeyStr);\n  const stage = stages[stageKeyStr];\n  \n  console.log(`\\nProcessing Stage ${stageNum}: ${stage.stageTitle}`);\n  \n  const tasks = [];\n  let workerIdx = 0;\n  \n  // Direct iteration - only process objects that have required fields\n  for (const key in stage) {\n    const taskData = stage[key];\n    \n    // Skip metadata - these have simple values, not objects with coordinates\n    if (!taskData || typeof taskData !== 'object' || !taskData.coordinates) {\n      continue;\n    }\n    \n    // This is a worker task\n    const actualWorker = workersByIndex[workerIdx];\n    if (!actualWorker) {\n      console.warn(`No worker at index ${workerIdx}`);\n      continue;\n    }\n    \n    console.log(`  Task ${key} → ${actualWorker.name} (port ${actualWorker.port})`);\n    \n    tasks.push({\n      sessionId: sessionId,\n      stageNumber: stageNum,\n      worker: actualWorker.name,\n      port: actualWorker.port,\n      taskPrompt: taskData.fullPrompt || '',\n      coordinates: taskData.coordinates,\n      status: taskData.status || 'queued'\n    });\n    \n    workerIdx++;\n  }\n  \n  stagesArray.push({\n    stageNumber: stageNum,\n    stageTitle: stage.stageTitle,\n    status: stage.status || 'not-started',\n    taskCount: tasks.length,\n    tasks: tasks\n  });\n});\n\nconsole.log(`\\n✅ Conversion complete: ${stagesArray.length} stages`);\n\nreturn { \n  stagesArray: stagesArray,\n  totalStages: stagesArray.length,\n  sessionId: sessionId,\n  workerCount: workers.length\n};"
            },
            "typeVersion": 2
        },
