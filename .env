BRAIN_MODE=external
EXTERNAL_API_PORT=4001
MULTIBOT_BASE_PORT=4002
#N8N_WEBHOOK_URL=https://127.0.0.1/webhook/worker-complete
BOT_NAME=Kodecraft

# Copy this to .env and fill in your actual values

# ============================================
# Node Environment
# ============================================
NODE_ENV=production
# NODE_ENV=development  # Use for development

# ============================================
# Display/Graphics (for Xvfb)
# ============================================
DISPLAY=:99

# ============================================
# Minecraft Server Configuration
# ============================================
MINECRAFT_HOST=localhost
MINECRAFT_PORT=55916
#MINECRAFT_USERNAME=bot_name
#MINECRAFT_PASSWORD=your_password
MINDSERVER_PORT=8080

# ============================================
# Bot Configuration
# ============================================
# Leader bot port
LEADER_BOT_PORT=4001

# Worker bot starting port (workers will use 4002, 4003, 4004, etc.)
WORKER_BOT_START_PORT=4002

# Maximum number of worker bots
MAX_WORKERS=5

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
# LOG_LEVEL=debug  # Verbose logging
# LOG_LEVEL=warn
# LOG_LEVEL=error

# ============================================
# Database Configuration (Optional)
# ============================================
# If using PostgreSQL for session tracking
#DB_HOST=postgres
#DB_PORT=5432
#DB_NAME=kodecraft
#DB_USER=kodecraft
#DB_PASSWORD=changeme
# DB_HOST=localhost  # If using host network


# ============================================
# API Configuration
# ============================================
API_TIMEOUT=30000
API_MAX_RETRIES=3

# ============================================
# Performance Tuning
# ============================================
# Number of parallel tasks per worker
TASKS_PER_WORKER=2

# Timeout for task execution (ms)
TASK_TIMEOUT=300000

# ============================================
# Debug Flags
# ============================================
DEBUG=false
VERBOSE_LOGGING=false


# N8N Configuration for HTTPS with DevTunnel
# n8n basic config for VS Code Tunnel dev
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_REVERSE_PROXY=true
N8N_SECURE_COOKIE=false
NODE_OPTIONS=--dns-result-order=ipv4first

N8N_EDITOR_BASE_URL="https://jzgsxmxd-5678.inc1.devtunnels.ms"
N8N_PUBLIC_URL="https://jzgsxmxd-5678.inc1.devtunnels.ms"
N8N_HOST="0.0.0.0"
WEBHOOK_URL="https://jzgsxmxd-5678.inc1.devtunnels.ms"

# Recommended deprecation settings (preemptive)
DB_SQLITE_POOL_SIZE=2
N8N_RUNNERS_ENABLED=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_GIT_NODE_DISABLE_BARE_REPOS=true

# OPTIONAL: development-only: disable CSRF checks (only if needed)
#N8N_ENFORCE_CSRF_CHECKS=false
