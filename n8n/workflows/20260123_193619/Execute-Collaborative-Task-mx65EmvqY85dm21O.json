ame] = updatedTasks;\n    workerIndex++;\n  }\n});\n\nreturn {\n  json: {\n    conversationId: webhookBody.conversationId,\n    sessionId: webhookBody.sessionId,\n    tasks: remappedTasks,\n    workers: updatedWorkers,\n    leader: leaderName\n  }\n};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-576,992],"id":"4c4b18e8-4f36-41e0-97cb-5b9262e96fd1","name":"Tasks remap"},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"400b3096-3e53-4fb4-858d-cab1f40c52f0","leftValue":"={{ $json.intent }}","rightValue":"goToPlayer","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"goToPlayer"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"0ea49596-a823-4d3b-b425-24825ac46688","leftValue":"={{ $json.intent }}","rightValue":"move","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"move"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"a78d6349-b2b3-4ce2-80c9-28a633f379dc","leftValue":"={{ $json.intent }}","rightValue":"searchForEntity","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"searchForEntity"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"94581748-c5b8-4f00-a942-114c1e9ed0a0","leftValue":"={{ $json.intent }}","rightValue":"moveWorker","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"moveWorker"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},